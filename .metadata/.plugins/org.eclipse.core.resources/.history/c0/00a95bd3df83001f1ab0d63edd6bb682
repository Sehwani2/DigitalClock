uint32_t IdleTimer;
volatile Mode mode;
volatile Mode previousMode;
ModeConfig watchModeConfig = { &(watchConfig.SubMode), NULL };
ModeConfig alarmModeConfig = { NULL, &(alarmSetting.alarmSubMode) };

bool AreAllButtonsIdle(void)
{
    return (Btn1.state == Idle && Btn2.state == Idle && Btn3.state == Idle && Btn4.state == Idle && watchConfig.SubMode == WATCH_CLOCK_SETTING);
}

void AutoSwitchToMode(ModeConfig *config)
{
	if(mode != WATCH && watchConfig != WATCH_NORMAL )
	{
		if(AreAllButtonsIdle())
		{
			IdleTimer ++;
		}
		else
		{
			IdleTimer  = 0;
		}
		printf("time : %d\n",IdleTimer);
		if(IdleTimer > 30*1000)
		{
			if (config->watchSubMode != NULL)
			{
				*(config->watchSubMode) = WATCH_NORMAL; //  시계 모드로 전환
			}
			if (config->alarmSubMode != NULL)
			{
				*(config->alarmSubMode) = ALARM_NORMAL; //  알람 모드로 전환
			}
			if (*(config->alarmSubMode) == ALARM_NORMAL)
			{
				*(config->watchSubMode) = WATCH_NORMAL; // 알람 모드일 때 시계 모드로 전환
			}
			IdleTimer  = 0;
	}
	}
}
